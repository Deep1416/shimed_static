# Apache directives (Plesk). Wrapped in IfModule so they are skipped, not fatal, if a module is missing.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Collapse /index.html to / so there is one canonical homepage URL
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
